[Unit]
Description=Webhook Dispatcher API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=webhook-dispatcher
Group=webhook-dispatcher
WorkingDirectory=/opt/webhook-dispatcher
Environment=NODE_ENV=production
EnvironmentFile=/etc/webhook-dispatcher/webhook-dispatcher.env
ExecStart=/usr/bin/node /opt/webhook-dispatcher/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
