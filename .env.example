PORT=5000

# Redis Configuration
# Option 1: Use connection string
# redis://localhost:6379 or rediss://user:password@host:6380/0
# REDIS_URL=

# Option 2: Use individual settings (default if REDIS_URL not set)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Worker Configuration
WORKER_CONCURRENCY=5
WEBHOOK_TIMEOUT=30000
MAX_RESPONSE_SIZE=1048576
WORKER_METRICS_PORT=9090
WORKER_JOB_LOCK_DURATION_MS=300000

# Per-destination outbound rate limiting (shared across all worker processes)
# Limits are enforced independently for each lowercase destination hostname
DESTINATION_RATE_LIMIT_MAX=10
DESTINATION_RATE_LIMIT_DURATION=60000
# Optional Redis key namespace
DESTINATION_RATE_LIMIT_KEY_PREFIX=webhook-dispatcher:destination-rate-limit

# Security Configuration
# API Authentication (REQUIRED in production)
# Generate a secure random key: openssl rand -hex 32
# Copy this file to .env, then set API_KEY to the generated value in .env.
# API_KEY=
API_KEY_HEADER=X-API-Key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_DISPATCH_MAX=50

# CORS Configuration
# Comma-separated list of allowed origins (omit for backend-only, use * for any origin)
# ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Proxy Configuration
# Set to 'true' if behind reverse proxy (nginx, ALB, etc.)
TRUST_PROXY=false

# Environment
NODE_ENV=development
LOG_LEVEL=debug
